---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { translations, type Locale } from "../i18n/translations";

interface Props {
  title: string;
  lang?: Locale | string;
  description?: string;
  type?: "website" | "article";
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  lang = "en",
  description = "A step-by-step educational roadmap and resource hub for families navigating pediatric cancer within the Canadian healthcare system.",
  type = "website",
  image = "/favicon.svg",
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props;

const currentLang = (lang as Locale) || "en";
const t = translations[currentLang] || translations.en;
const siteUrl = Astro.site
  ? Astro.site.toString().replace(/\/$/, "")
  : "https://canadian-pediatric-oncology.github.io/pediatric_oncology";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageURL = new URL(image, siteUrl).toString();

const ogLocale =
  currentLang === "fr" ? "fr_CA" : currentLang === "zh" ? "zh_CN" : "en_CA";
---

<!doctype html>
<html lang={lang} class="antialiased text-gray-900 bg-gray-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title} | {t.brandName}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ${t.brandName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={t.brandName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImageURL} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={`${title} | ${t.brandName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- JSON-LD Structured Data -->
    {
      structuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData)}
        />
      )
    }

    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:font-bold focus:rounded-md focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary-dark"
    >
      {t.nav.skipToMain}
    </a>
    <Header />
    <main
      id="main-content"
      class="flex-grow max-w-4xl mx-auto w-full px-6 py-12"
      data-pagefind-body
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
