---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import MedicalDisclaimer from "../../../components/MedicalDisclaimer.astro";
import Badge from "../../../components/Badge.astro";
import Prose from "../../../components/Prose.astro";
import { translations, type Locale } from "../../../i18n/translations";

export async function getStaticPaths() {
  const allSymptoms = await getCollection("symptoms");

  return allSymptoms.map((step) => {
    const [lang, filename] = step.id.split("/");
    const slug = filename.replace(".md", "");

    return {
      params: { lang, slug },
      props: { step },
    };
  });
}

const { step } = Astro.props;
const { Content } = await render(step);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentLang = (step.data.lang as Locale) || "en";
const t = translations[currentLang] || translations.en;
const homeUrl =
  currentLang === "en" ? `${basePath}/` : `${basePath}/${currentLang}`;
const langPrefix = `${basePath}/${currentLang}`;

const breadcrumbs = [
  { label: t.nav.home, href: homeUrl },
  { label: t.nav.symptoms, href: `${langPrefix}/symptoms` },
  { label: step.data.title },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: step.data.title,
  description: `At-home pediatric symptom management guide for ${step.data.title} (Severity: ${step.data.severity}).`,
  inLanguage: step.data.lang,
  dateModified: step.data.last_medically_reviewed_date || "2026-08-23",
  lastReviewed: step.data.last_medically_reviewed_date || "2026-08-23",
  reviewedBy: {
    "@type": "MedicalOrganization",
    name: "Canadian Pediatric Oncology Medical Review Team",
  },
  publisher: {
    "@type": "Organization",
    name: "Canadian Pediatric Oncology Educational Platform",
    url: "https://canadian-pediatric-oncology.github.io/pediatric_oncology/",
  },
  about: {
    "@type": "MedicalSignOrSymptom",
    name: step.data.title,
  },
};
---

<Layout
  title={step.data.title}
  lang={step.data.lang}
  type="article"
  description={`At-home symptom management guide: ${step.data.title}. Severity: ${step.data.severity}. Clear clinical protocols for parents.`}
  modifiedTime={step.data.last_medically_reviewed_date}
  structuredData={structuredData}
>
  <Breadcrumbs crumbs={breadcrumbs} lang={currentLang} />

  <div class="mb-8 border-b pb-6">
    <div class="flex items-center gap-3 mb-2">
      <span class="text-sm font-semibold text-primary uppercase tracking-wider"
        >{t.symptoms.guideBadge}</span
      >
      <Badge
        variant="severity"
        label={t.symptoms.severity}
        value={step.data.severity}
      />
    </div>
    <h1
      class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl"
    >
      {step.data.title}
    </h1>
    <div class="mt-3 text-xs text-gray-500 flex flex-wrap items-center gap-4">
      <span>{t.symptoms.reviewedBy} {step.data.author}</span>
      <span>•</span>
      <span
        >{t.symptoms.lastReviewed}
        {step.data.last_medically_reviewed_date}</span
      >
    </div>
  </div>

  <Prose>
    <Content />
  </Prose>

  <MedicalDisclaimer lang={step.data.lang} />

  <div class="mt-8 pt-6 border-t border-gray-200">
    <a
      href={`${basePath}/${step.data.lang}/symptoms`}
      class="inline-flex items-center text-sm font-medium text-gray-600 hover:text-primary transition-colors"
    >
      &larr; {t.symptoms.back}
    </a>
  </div>
</Layout>
