---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { translations, type Locale } from "../../../i18n/translations";

export async function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "fr" } },
    { params: { lang: "zh" } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang as Locale) || "en";
const t = translations[currentLang] || translations.en;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl =
  currentLang === "en" ? `${basePath}/` : `${basePath}/${currentLang}`;

const breadcrumbs = [
  { label: t.nav.home, href: homeUrl },
  { label: t.nav.symptoms },
];

const allSymptoms = await getCollection("symptoms", (s) =>
  s.id.startsWith(`${currentLang}/`),
);
---

<Layout
  title={t.symptoms.title}
  lang={currentLang}
  description={t.symptoms.subtitle}
>
  <Breadcrumbs crumbs={breadcrumbs} lang={currentLang} />

  <div class="mb-8 border-b pb-6">
    <div class="flex items-center gap-3">
      <div class="p-2 bg-accent-light rounded-lg">
        <svg
          class="w-8 h-8 text-accent shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
          ></path></svg
        >
      </div>
      <h1
        class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl text-balance"
      >
        {t.symptoms.title}
      </h1>
    </div>
    <p class="mt-4 text-lg text-gray-600 text-balance">
      {t.symptoms.subtitle}
    </p>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      allSymptoms.map((symptom) => {
        const slug = symptom.id.split("/")[1].replace(".md", "");
        return (
          <a
            href={`${basePath}/${currentLang}/symptoms/${slug}`}
            class="flex flex-col justify-between h-full p-6 bg-white rounded-lg border border-gray-200 shadow-sm hover:shadow-lg hover:-translate-y-1 hover:scale-[1.02] transition-all duration-300 no-underline"
          >
            <div class="flex items-center gap-2 mb-2">
              <span
                class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${symptom.data.severity.toLowerCase().includes("high") || symptom.data.severity.toLowerCase().includes("élevée") || symptom.data.severity.toLowerCase().includes("高") ? "bg-red-100 text-red-800" : "bg-yellow-100 text-yellow-800"}`}
              >
                {symptom.data.severity}
              </span>
            </div>
            <h2 class="text-xl font-bold text-gray-900 text-balance">
              {symptom.data.title}
            </h2>
            <p class="text-sm text-primary mt-4 font-medium">
              {t.symptoms.readGuide}
            </p>
          </a>
        );
      })
    }
  </div>
</Layout>
