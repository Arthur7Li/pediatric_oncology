---
import Layout from "../../layouts/Layout.astro";
import { translations, type Locale } from "../../i18n/translations";

export async function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "fr" } },
    { params: { lang: "zh" } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang as Locale) || "en";
const t = translations[currentLang] || translations.en;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const langPrefix = `${basePath}/${currentLang}`;
---

<Layout title={t.home.title} lang={currentLang} description={t.home.subtitle}>
  <div class="text-center py-12 flex flex-col items-center">
    <!-- Gentle, abstract illustration -->
    <svg
      class="w-48 h-48 mb-8 text-sky-100"
      viewBox="0 0 200 200"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <path
        fill="currentColor"
        d="M44.7,-76.4C58.8,-69.2,71.8,-59.1,81.3,-46.3C90.8,-33.5,96.8,-17.9,95.5,-3.1C94.2,11.8,85.6,25.9,76,38.8C66.4,51.7,55.8,63.4,42.8,71.4C29.8,79.4,14.9,83.7,0.1,83.4C-14.6,83.2,-29.3,78.5,-41.4,70C-53.5,61.5,-63.1,49.2,-72.1,35.9C-81.1,22.6,-89.6,8.3,-90.1,-6.3C-90.6,-20.9,-83.1,-35.8,-72.4,-47.5C-61.7,-59.2,-47.8,-67.7,-33.6,-74.6C-19.4,-81.5,-4.9,-86.8,9.1,-86.4C23,-85.9,46,-79.7,44.7,-76.4Z"
        transform="translate(100 100) scale(1.1)"></path>
      <path
        fill="#026aa2"
        opacity="0.8"
        d="M37.3,-58.3C49.9,-46.5,62.8,-36.5,70.9,-23.1C79,-9.7,82.3,7,78.3,21.7C74.3,36.4,63,49.1,49.5,58.3C36,67.5,20.3,73.2,4.8,65.1C-10.7,57,-26,35.1,-39.6,22.2C-53.2,9.3,-65.1,5.4,-67.5,-1.3C-69.9,-8,-62.8,-17.5,-55,-26C-47.2,-34.5,-38.7,-42,-28.9,-51.7C-19.1,-61.4,-8,-73.3,2.8,-78C13.6,-82.7,24.7,-70.1,37.3,-58.3Z"
        transform="translate(100 100) scale(0.9)"></path>
      <circle cx="100" cy="100" r="20" fill="#ffffff" opacity="0.9"></circle>
    </svg>

    <h1
      class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl"
    >
      {t.home.title}
    </h1>
    <p class="mt-6 text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
      {t.home.subtitle}
    </p>
    <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
      <a
        href={`${langPrefix}/journey/1-diagnosis`}
        class="rounded-md bg-primary px-8 py-4 text-lg font-semibold text-white shadow-md hover:bg-primary-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary no-underline transition-colors"
      >
        {t.home.startJourneyBtn}
      </a>
      <a
        href={`${langPrefix}/financial`}
        class="rounded-md bg-white px-8 py-4 text-lg font-semibold text-gray-900 shadow-md ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary no-underline transition-colors"
      >
        {t.home.financialBtn}
      </a>
    </div>
  </div>
</Layout>
