---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProvincialFilter from "../../components/ProvincialFilter.astro";
import { translations, type Locale } from "../../i18n/translations";

export async function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "fr" } },
    { params: { lang: "zh" } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang as Locale) || "en";
const t = translations[currentLang] || translations.en;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl =
  currentLang === "en" ? `${basePath}/` : `${basePath}/${currentLang}`;

const breadcrumbs = [
  { label: t.nav.home, href: homeUrl },
  { label: t.nav.support },
];

const usHospitals = [
  {
    name: "St. Jude Children's Research Hospital (Memphis, TN)",
    desc:
      currentLang === "fr"
        ? "Hôpital de renommée mondiale dédié aux maladies infantiles catastrophiques et auteur de Together by St. Jude™."
        : currentLang === "zh"
          ? "全球公认的儿童恶性肿瘤顶级科研与治疗机构，开发了享誉全球的 Together by St. Jude™ 患儿家庭教育平台。"
          : "Globally recognized leader in catastrophic childhood disease research and creators of Together by St. Jude™.",
    linkText: "Together by St. Jude™ Education Hub",
    linkUrl: "https://together.stjude.org/",
  },
  {
    name: "Children's Hospital of Philadelphia (CHOP) (Philadelphia, PA)",
    desc:
      currentLang === "fr"
        ? "Pionnier mondial des thérapies cellulaires et du soutien psychosocial des familles."
        : currentLang === "zh"
          ? "在儿童白血病免疫治疗、细胞疗法和家庭心理健康支持领域享誉国际。"
          : "World leader in cellular immunotherapy clinical trials and holistic family psychosocial support.",
    linkText: "CHOP Cancer Center Resources",
    linkUrl: "https://www.chop.edu/cancer",
  },
];
---

<Layout
  title={t.support.title}
  lang={currentLang}
  description={t.support.subtitle}
>
  <Breadcrumbs crumbs={breadcrumbs} lang={currentLang} />
  <div class="mb-8 border-b pb-6">
    <div class="flex items-center gap-3">
      <div class="p-2 bg-accent-light rounded-lg">
        <svg
          class="w-8 h-8 text-accent shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
          ></path></svg
        >
      </div>
      <h1
        class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl text-balance"
      >
        {t.support.title}
      </h1>
    </div>
    <p class="mt-4 text-lg text-gray-600 text-balance">
      {t.support.subtitle}
    </p>
  </div>

  <ProvincialFilter lang={currentLang} />

  <section
    id="national-fallback-section"
    class="mt-12 pt-8 border-t border-gray-200"
  >
    <h2 class="text-2xl font-bold text-gray-900 mb-2">
      {t.support.nationalTitle}
    </h2>
    <p class="text-gray-600 mb-6 text-sm sm:text-base">
      {t.support.nationalSubtitle}
    </p>

    <article class="prose max-w-none mb-12">
      {
        currentLang === "fr" ? (
          <div>
            <h2>1. Couverture des régimes provinciaux de santé au Canada</h2>
            <p>
              Au Canada, les régimes publics d'assurance maladie (comme la RAMQ
              au Québec, l'OHIP en Ontario et le MSP en Colombie-Britannique)
              fonctionnent conformément à la{" "}
              <em>Loi canadienne sur la santé</em>.{" "}
              <strong>
                Tous les soins et séjours hospitaliers médicalement nécessaires
                sont entièrement pris en charge sans frais directs.
              </strong>
            </p>
            <ul>
              <li>
                <strong>Traitements hospitaliers :</strong> Chimiothérapie,
                radiothérapie, chirurgies et thérapies cellulaires reçues à
                l'hôpital.
              </li>
              <li>
                <strong>Frais non couverts à prévoir :</strong> Médicaments pris
                à domicile (ex. antiémétiques oraux), stationnement hospitalier,
                déplacements et hébergement.
              </li>
            </ul>

            <h2>
              2. Prestation d'assurance-emploi pour proches aidants d'enfants
            </h2>
            <p>
              Le gouvernement du Canada offre la{" "}
              <strong>Prestation pour proches aidants d'enfants</strong> pour
              compenser la perte de revenu des parents devant s'absenter du
              travail afin de soutenir un enfant gravement malade :
            </p>
            <ul>
              <li>
                <strong>Durée :</strong> Jusqu'à <strong>35 semaines</strong> de
                prestations partagables entre les parents.
              </li>
              <li>
                <strong>Admissibilité :</strong> Réduction de plus de 40 % du
                revenu hebdomadaire et 600 heures d'emploi assurable.
              </li>
            </ul>
          </div>
        ) : currentLang === "zh" ? (
          <div>
            <h2>1. 加拿大各省医疗保险 (Medicare) 覆盖范围</h2>
            <p>
              在加拿大，《加拿大卫生法》(Canada Health Act)
              确保所有居民在公立医院内接受的
              <strong>
                所有必要医疗服务（包括住院、化疗、手术、放疗及院内处方药）均由省医保100%全额覆盖
              </strong>
              。
            </p>
            <ul>
              <li>
                <strong>医院内全额报销项目：</strong>{" "}
                肿瘤手术、住院化疗与放疗、专科医生会诊、住院期间所有药物。
              </li>
              <li>
                <strong>可能产生的自费开支：</strong>{" "}
                出院后带回家的口服药物、医院停车费、跨城市就医的交通与住宿费。
              </li>
            </ul>

            <h2>2. 加拿大联邦就业保险 (EI) 儿童看护津贴</h2>
            <p>
              为照顾重病患儿而需要暂停工作的父母，可申请加拿大联邦政府提供的
              <strong>
                重病儿童看护津贴 (Family Caregiver Benefit for Children)
              </strong>
              ：
            </p>
            <ul>
              <li>
                <strong>津贴周数：</strong> 最多可领取 <strong>35 周</strong>
                ，可在52周内分段使用。
              </li>
              <li>
                <strong>申请条件：</strong>{" "}
                每周收入减少40%以上，且在申请前52周内累计至少600小时受保工作时间。
              </li>
            </ul>
          </div>
        ) : (
          <div>
            <h2>1. Provincial Healthcare Coverage: What to Expect</h2>
            <p>
              In Canada, provincial healthcare systems operate under the{" "}
              <em>Canada Health Act</em>. This means that{" "}
              <strong>
                medically necessary services provided in a hospital are fully
                covered
              </strong>
              .
            </p>
            <ul>
              <li>
                <strong>In-Hospital Treatments:</strong> Chemotherapy,
                radiation, cellular therapies, and surgeries administered while
                your child is admitted.
              </li>
              <li>
                <strong>Out-of-Pocket Expenses:</strong> Take-home
                prescriptions, hospital parking, and travel/accommodation.
              </li>
            </ul>

            <h2>
              2. Employment Insurance (EI): Family Caregiver Benefit for
              Children
            </h2>
            <p>
              The Government of Canada offers the{" "}
              <strong>Family Caregiver Benefit for Children</strong> to help
              offset lost income when parents take time away from work:
            </p>
            <ul>
              <li>
                <strong>Duration:</strong> Up to <strong>35 weeks</strong> of
                benefits, shareable between eligible caregivers over a 52-week
                window.
              </li>
              <li>
                <strong>Eligibility:</strong> A reduction of more than 40% in
                regular weekly earnings and 600 insurable hours accumulated in
                the preceding 52 weeks.
              </li>
            </ul>
          </div>
        )
      }
    </article>

    <div class="grid gap-6 md:grid-cols-2">
      {
        usHospitals.map((hospital) => (
          <div class="p-6 bg-gray-50 rounded-lg border border-gray-200 shadow-sm flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                {hospital.name}
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed mb-4">
                {hospital.desc}
              </p>
            </div>
            <div>
              <a
                href={hospital.linkUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-semibold text-primary hover:text-primary-dark inline-flex items-center gap-1"
              >
                <span>{hospital.linkText}</span>
                <span class="sr-only">(opens in a new tab)</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
