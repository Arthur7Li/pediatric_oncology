---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import MedicalDisclaimer from "../../../components/MedicalDisclaimer.astro";
import { translations, type Locale } from "../../../i18n/translations";

export async function getStaticPaths() {
  const allJourneySteps = await getCollection("journey");

  return allJourneySteps.map((step) => {
    const [lang, filename] = step.id.split("/");
    const slug = filename.replace(".md", "");

    return {
      params: { lang, slug },
      props: { step },
    };
  });
}

const { step } = Astro.props;
const { Content } = await render(step);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentLang = (step.data.lang as Locale) || "en";
const t = translations[currentLang] || translations.en;
const homeUrl =
  currentLang === "en" ? `${basePath}/` : `${basePath}/${currentLang}`;
const langPrefix = `${basePath}/${currentLang}`;

// To figure out next and previous, we query the same language collection
const allStepsInLang = await getCollection("journey", (s) =>
  s.id.startsWith(`${step.data.lang}/`),
);
allStepsInLang.sort((a, b) => a.data.step - b.data.step);

const currentIndex = allStepsInLang.findIndex((s) => s.id === step.id);
const prevStep = currentIndex > 0 ? allStepsInLang[currentIndex - 1] : null;
const nextStep =
  currentIndex < allStepsInLang.length - 1
    ? allStepsInLang[currentIndex + 1]
    : null;

// Helper to construct URLs
const getUrl = (s: any) => {
  const [lang, filename] = s.id.split("/");
  return `${basePath}/${lang}/journey/${filename.replace(".md", "")}`;
};

const breadcrumbs = [
  { label: t.nav.home, href: homeUrl },
  { label: t.nav.journey, href: `${langPrefix}/journey/1-diagnosis` },
  { label: step.data.title },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: step.data.title,
  description: `Step ${step.data.step} of the pediatric cancer treatment journey in Canada: ${step.data.title}.`,
  inLanguage: step.data.lang,
  dateModified: step.data.last_medically_reviewed_date || "2026-08-23",
  lastReviewed: step.data.last_medically_reviewed_date || "2026-08-23",
  reviewedBy: {
    "@type": "MedicalOrganization",
    name: "Canadian Pediatric Oncology Medical Review Team",
  },
  publisher: {
    "@type": "Organization",
    name: "Canadian Pediatric Oncology Educational Platform",
    url: "https://canadian-pediatric-oncology.github.io/pediatric_oncology/",
  },
  audience: {
    "@type": "MedicalAudience",
    audienceType: "Patient & Family",
  },
};
---

<Layout
  title={step.data.title}
  lang={step.data.lang}
  type="article"
  description={`Step ${step.data.step} of ${allStepsInLang.length}: ${step.data.title}. Medically verified roadmap for Canadian families.`}
  modifiedTime={step.data.last_medically_reviewed_date || "2026-08-23"}
  structuredData={structuredData}
>
  <Breadcrumbs crumbs={breadcrumbs} lang={currentLang} />

  <div class="mb-8 border-b pb-6">
    <div class="flex items-start gap-4">
      <div class="p-2 bg-accent-light rounded-lg mt-1 shrink-0">
        <svg
          class="w-8 h-8 text-accent"
          fill="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          ><path
            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
          ></path></svg
        >
      </div>
      <div>
        <span
          class="text-sm font-semibold text-primary uppercase tracking-wider"
        >
          {
            step.data.lang === "fr"
              ? `Étape ${step.data.step} de ${allStepsInLang.length}`
              : step.data.lang === "zh"
                ? `第 ${step.data.step} 阶段 (共 ${allStepsInLang.length} 阶段)`
                : `Step ${step.data.step} of ${allStepsInLang.length}`
          }
        </span>
        <h1
          class="mt-2 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl text-balance"
        >
          {step.data.title}
        </h1>
      </div>
    </div>
  </div>

  <article class="prose max-w-none mb-8">
    <Content />
  </article>

  <MedicalDisclaimer lang={step.data.lang} />

  <!-- Wizard Navigation -->
  <div class="border-t border-gray-200 pt-8 flex justify-between items-center">
    <div>
      {
        prevStep ? (
          <a
            href={getUrl(prevStep)}
            class="inline-flex items-center text-sm font-medium text-gray-600 hover:text-primary transition-colors"
          >
            &larr;{" "}
            {step.data.lang === "fr"
              ? "Étape précédente"
              : step.data.lang === "zh"
                ? "上一阶段"
                : "Previous Phase"}
          </a>
        ) : (
          <a
            href={homeUrl}
            class="inline-flex items-center text-sm font-medium text-gray-600 hover:text-primary transition-colors"
          >
            &larr;{" "}
            {step.data.lang === "fr"
              ? "Retour à l'accueil"
              : step.data.lang === "zh"
                ? "返回首页"
                : "Back to Home"}
          </a>
        )
      }
    </div>

    <div>
      {
        nextStep && (
          <a
            href={getUrl(nextStep)}
            class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-primary hover:bg-primary-dark transition-colors"
          >
            {step.data.lang === "fr"
              ? "Étape suivante →"
              : step.data.lang === "zh"
                ? "下一阶段 →"
                : "Next Phase →"}
          </a>
        )
      }
    </div>
  </div>
</Layout>
