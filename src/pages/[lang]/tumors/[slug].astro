---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import MedicalDisclaimer from "../../../components/MedicalDisclaimer.astro";
import Badge from "../../../components/Badge.astro";
import Prose from "../../../components/Prose.astro";
import { translations, type Locale } from "../../../i18n/translations";

export async function getStaticPaths() {
  const allTumors = await getCollection("tumors");

  return allTumors.map((tumor) => {
    const [lang, filename] = tumor.id.split("/");
    const slug = filename.replace(".md", "");

    return {
      params: { lang, slug },
      props: { tumor },
    };
  });
}

const { tumor } = Astro.props;
const { Content } = await render(tumor);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentLang = (tumor.data.lang as Locale) || "en";
const t = translations[currentLang] || translations.en;
const homeUrl =
  currentLang === "en" ? `${basePath}/` : `${basePath}/${currentLang}`;
const langPrefix = `${basePath}/${currentLang}`;

const breadcrumbs = [
  { label: t.nav.home, href: homeUrl },
  { label: t.nav.tumors, href: `${langPrefix}/tumors` },
  { label: tumor.data.title },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: tumor.data.title,
  description: `Medically verified Canadian clinical guide for pediatric ${tumor.data.title} (${tumor.data.incidence}).`,
  inLanguage: tumor.data.lang,
  dateModified: tumor.data.last_medically_reviewed_date || "2026-08-23",
  lastReviewed: tumor.data.last_medically_reviewed_date || "2026-08-23",
  reviewedBy: {
    "@type": "MedicalOrganization",
    name: "Canadian Pediatric Oncology Medical Review Team",
  },
  publisher: {
    "@type": "Organization",
    name: "Canadian Pediatric Oncology Educational Platform",
    url: "https://canadian-pediatric-oncology.github.io/pediatric_oncology/",
  },
  about: {
    "@type": "MedicalCondition",
    name: tumor.data.title,
  },
  citation: tumor.data.authoritative_sources || [],
};
---

<Layout
  title={tumor.data.title}
  lang={tumor.data.lang}
  type="article"
  description={`Pediatric clinical guide for ${tumor.data.title}. Incidence: ${tumor.data.incidence}. Authoritative Canadian cancer information.`}
  modifiedTime={tumor.data.last_medically_reviewed_date}
  structuredData={structuredData}
>
  <Breadcrumbs crumbs={breadcrumbs} lang={currentLang} />

  <div class="mb-8 border-b pb-6">
    <div class="flex items-center gap-3 mb-2">
      <span class="text-sm font-semibold text-primary uppercase tracking-wider"
        >{t.tumors.guideBadge}</span
      >
      <Badge
        variant="incidence"
        label={t.tumors.incidence}
        value={tumor.data.incidence}
      />
    </div>
    <h1
      class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl"
    >
      {tumor.data.title}
    </h1>
    <div class="mt-3 text-xs text-gray-500 flex flex-wrap items-center gap-4">
      <span>{t.tumors.reviewedBy} {tumor.data.author}</span>
      <span>•</span>
      <span
        >{t.tumors.lastReviewed} {tumor.data.last_medically_reviewed_date}</span
      >
    </div>
  </div>

  <Prose>
    <Content />
  </Prose>

  {
    tumor.data.authoritative_sources &&
      tumor.data.authoritative_sources.length > 0 && (
        <div class="my-8 p-4 bg-gray-50 rounded-lg border border-gray-200">
          <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">
            {t.tumors.sources}
          </h3>
          <ul class="list-disc pl-5 text-sm text-gray-600 space-y-1">
            {tumor.data.authoritative_sources.map((source: string) => (
              <li>{source}</li>
            ))}
          </ul>
        </div>
      )
  }

  <MedicalDisclaimer lang={tumor.data.lang} />

  <div class="mt-8 pt-6 border-t border-gray-200">
    <a
      href={`${basePath}/${tumor.data.lang}/tumors`}
      class="inline-flex items-center text-sm font-medium text-gray-600 hover:text-primary transition-colors"
    >
      &larr; {t.tumors.back}
    </a>
  </div>
</Layout>
