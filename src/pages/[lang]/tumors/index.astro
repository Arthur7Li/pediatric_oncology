---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { translations, type Locale } from "../../../i18n/translations";

export async function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "fr" } },
    { params: { lang: "zh" } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang as Locale) || "en";
const t = translations[currentLang] || translations.en;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl =
  currentLang === "en" ? `${basePath}/` : `${basePath}/${currentLang}`;

const breadcrumbs = [
  { label: t.nav.home, href: homeUrl },
  { label: t.nav.tumors },
];

const allTumors = await getCollection("tumors", (tumor) =>
  tumor.id.startsWith(`${currentLang}/`),
);
---

<Layout
  title={t.tumors.title}
  lang={currentLang}
  description={t.tumors.subtitle}
>
  <Breadcrumbs crumbs={breadcrumbs} lang={currentLang} />

  <div class="mb-8 border-b pb-6">
    <h1
      class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl"
    >
      {t.tumors.title}
    </h1>
    <p class="mt-4 text-lg text-gray-600">
      {t.tumors.subtitle}
    </p>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      allTumors.map((tumor) => {
        const slug = tumor.id.split("/")[1].replace(".md", "");
        return (
          <a
            href={`${basePath}/${currentLang}/tumors/${slug}`}
            class="block p-6 bg-white rounded-lg border border-gray-200 shadow-sm hover:shadow-md transition-shadow no-underline"
          >
            <div class="flex items-center gap-2 mb-2">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sky-100 text-sky-900">
                {tumor.data.incidence}
              </span>
            </div>
            <h2 class="text-xl font-bold text-gray-900 mt-2">
              {tumor.data.title}
            </h2>
            <p class="text-sm text-primary mt-4 font-medium">
              {t.tumors.readGuide}
            </p>
          </a>
        );
      })
    }
  </div>
</Layout>
