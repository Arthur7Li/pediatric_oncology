---
import { type Locale } from "../i18n/translations";

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
  lang?: Locale | string;
}

const { crumbs = [], lang = "en" } = Astro.props;

const siteUrl = Astro.site
  ? Astro.site.toString().replace(/\/$/, "")
  : "https://canadian-pediatric-oncology.github.io/pediatric_oncology";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.label,
    ...(crumb.href ? { item: new URL(crumb.href, siteUrl).toString() } : {}),
  })),
};
---

{
  crumbs && crumbs.length > 0 && (
    <nav
      aria-label={
        lang === "fr"
          ? "Fil d'Ariane"
          : lang === "zh"
            ? "面包屑导航"
            : "Breadcrumb"
      }
      class="mb-6 py-1"
      data-pagefind-ignore
    >
      <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs sm:text-sm text-gray-700 list-none p-0 m-0">
        {crumbs.map((crumb, index) => {
          const isLast = index === crumbs.length - 1 || !crumb.href;
          return (
            <li class="inline-flex items-center gap-1.5 sm:gap-2">
              {isLast ? (
                <span
                  class="font-bold text-gray-900 truncate max-w-[220px] sm:max-w-md"
                  aria-current="page"
                >
                  {crumb.label}
                </span>
              ) : (
                <>
                  <a
                    href={crumb.href}
                    class="text-gray-700 hover:text-primary hover:underline transition-colors focus:outline-none focus:ring-2 focus:ring-primary rounded px-0.5 font-medium no-underline"
                  >
                    {crumb.label}
                  </a>
                  <span
                    class="text-gray-500 select-none font-bold"
                    aria-hidden="true"
                  >
                    /
                  </span>
                </>
              )}
            </li>
          );
        })}
      </ol>

      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbSchema)}
      />
    </nav>
  )
}
