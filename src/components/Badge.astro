---
interface Props {
  variant?: "severity" | "incidence" | "phase" | "default";
  label?: string;
  value: string;
  class?: string;
}

const {
  variant = "default",
  label,
  value,
  class: extraClass = "",
} = Astro.props;

// Determine badge color classes based on variant and localized value
function getBadgeColors(variant: string, text: string) {
  if (variant === "severity") {
    const lower = text.toLowerCase();
    // High / Urgent / Élevée / 高
    if (
      lower.includes("high") ||
      lower.includes("urgent") ||
      lower.includes("emergency") ||
      lower.includes("élevée") ||
      lower.includes("elevee") ||
      text.includes("高")
    ) {
      return "bg-red-100 text-red-800 border-red-200";
    }
    // Moderate / Modérée / 中
    if (
      lower.includes("moderate") ||
      lower.includes("medium") ||
      lower.includes("modérée") ||
      lower.includes("moderee") ||
      text.includes("中")
    ) {
      return "bg-amber-100 text-amber-900 border-amber-200";
    }
    // Low / Faible / 低 or default
    return "bg-yellow-100 text-yellow-800 border-yellow-200";
  }

  if (variant === "incidence") {
    return "bg-sky-100 text-sky-900 border-sky-200";
  }

  if (variant === "phase") {
    return "bg-rose-100 text-rose-900 border-rose-200";
  }

  return "bg-gray-100 text-gray-800 border-gray-200";
}

const colorClasses = getBadgeColors(variant, value);
---

<span
  class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border ${colorClasses} ${extraClass}`}
>
  {label ? `${label}: ${value}` : value}
</span>
