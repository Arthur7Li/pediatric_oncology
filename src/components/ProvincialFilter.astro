---
import { translations, type Locale } from "../i18n/translations";
import { getCollection } from "astro:content";

interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;
const currentLang = (lang as Locale) || "en";
const t = translations[currentLang] || translations.en;

// Fetch all provinces for the current language
const provincesContent = await getCollection("provinces", ({ data }) => {
  return data.lang === currentLang;
});

// Sort alphabetically by title
provincesContent.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Serialize to pass to the web component
const serializedProvinces = provincesContent.map((p) => ({
  id: p.data.province_key,
  title: p.data.title,
  hospitals: p.data.hospitals,
  financial: p.data.financial,
  notes: p.body,
}));
---

<provincial-filter
  data-resources={JSON.stringify(serializedProvinces)}
  data-selected-resources-str={t.filter.selectedResources}
  data-notes-heading={t.filter.notesHeading}
  class="block"
>
  <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200 my-8">
    <label
      for="province-select"
      class="block text-lg font-bold text-gray-900 mb-4"
    >
      {t.filter.label}
    </label>
    <select
      id="province-select"
      class="block w-full max-w-sm pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-primary focus:border-primary sm:text-sm rounded-md bg-gray-50 border"
    >
      <option value="" disabled selected>{t.filter.placeholder}</option>
      {
        serializedProvinces.map((res) => (
          <option value={res.id}>{res.title}</option>
        ))
      }
    </select>

    <div
      id="resource-display"
      class="mt-6 hidden"
      aria-live="polite"
      aria-atomic="true"
    >
      <h2 id="display-province" class="text-xl font-bold text-primary mb-3">
        {t.filter.selectedHeading}
      </h2>

      <div class="mb-6">
        <h3 class="font-semibold text-gray-800 border-b pb-1 mb-4">
          {t.filter.hospitalsHeading}
        </h3>
        <div id="display-hospitals" class="grid gap-4 md:grid-cols-2">
          <!-- Dynamically populated -->
        </div>
      </div>

      <div class="mb-4">
        <h3 class="font-semibold text-gray-800 border-b pb-1 mb-2">
          {t.filter.financialHeading}
        </h3>
        <ul
          id="display-financial"
          class="list-disc pl-5 text-gray-700 space-y-1"
        >
          <!-- Dynamically populated -->
        </ul>
      </div>

      <div
        id="display-notes-container"
        class="mt-4 p-4 bg-amber-50 border-l-4 border-amber-400 text-amber-800 text-sm italic hidden rounded-r"
      >
        <span id="display-notes"></span>
      </div>
    </div>
  </div>
</provincial-filter>

<script>
  class ProvincialFilter extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector<HTMLSelectElement>("#province-select");
      const display = this.querySelector("#resource-display");
      const displayProvince = this.querySelector("#display-province");
      const displayHospitals = this.querySelector("#display-hospitals");
      const displayFinancial = this.querySelector("#display-financial");
      const displayNotesContainer = this.querySelector(
        "#display-notes-container",
      );
      const displayNotes = this.querySelector("#display-notes");

      if (!select || !display) return;

      const resources = JSON.parse(this.dataset.resources || "[]");
      const selectedResourcesStr = this.dataset.selectedResourcesStr || "";
      const notesHeading = this.dataset.notesHeading || "";

      select.addEventListener("change", (e) => {
        const target = e.target as HTMLSelectElement;
        const selectedProv = target.value;
        const data = resources.find((r: any) => r.id === selectedProv);

        if (data) {
          display.classList.remove("hidden");
          const nationalSection = document.getElementById(
            "national-fallback-section",
          );
          if (nationalSection) {
            nationalSection.classList.add("hidden");
          }

          if (displayProvince) {
            displayProvince.textContent = data.title + selectedResourcesStr;
          }

          if (displayHospitals) {
            displayHospitals.innerHTML = data.hospitals
              .map(
                (h: any) => `
              <div class="p-4 bg-gray-50 rounded border border-gray-200">
                <h4 class="font-bold text-gray-900 mb-1">${h.name}</h4>
                <p class="text-xs text-gray-600 mb-2">${h.desc}</p>
                <a href="${h.linkUrl}" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-primary hover:underline">
                  ${h.linkText} &rarr;
                </a>
              </div>
            `,
              )
              .join("");
          }

          if (displayFinancial) {
            displayFinancial.innerHTML = data.financial
              .map((f: string) => `<li>${f}</li>`)
              .join("");
          }

          if (displayNotesContainer && displayNotes) {
            if (data.notes && data.notes.trim() !== "") {
              displayNotesContainer.classList.remove("hidden");
              displayNotes.innerHTML = `<strong>${notesHeading}</strong> ${data.notes}`;
            } else {
              displayNotesContainer.classList.add("hidden");
            }
          }
        }
      });
    }
  }

  if (!customElements.get("provincial-filter")) {
    customElements.define("provincial-filter", ProvincialFilter);
  }
</script>
