---
import { translations, type Locale } from "../i18n/translations";
import SearchBar from "./SearchBar.astro";

const pathname = Astro.url.pathname;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

// Normalize clean path without basePath prefix for language parsing
const cleanPath =
  basePath && pathname.startsWith(basePath)
    ? pathname.slice(basePath.length) || "/"
    : pathname;

// Detect current language from URL prefix
const langMatch = cleanPath.match(/^\/(en|fr|zh)(\/.*)?$/);
const currentLang: Locale = (langMatch ? langMatch[1] : "en") as Locale;
const remainingPath = langMatch ? langMatch[2] || "" : cleanPath;

const t = translations[currentLang] || translations.en;

// Generate language toggle URLs that strictly preserve the current page
function getLangUrl(targetLang: Locale) {
  if (
    cleanPath.startsWith("/en/") ||
    cleanPath.startsWith("/fr/") ||
    cleanPath.startsWith("/zh/")
  ) {
    return `${basePath}/${targetLang}${remainingPath}`;
  }
  if (
    cleanPath === "/en" ||
    cleanPath === "/fr" ||
    cleanPath === "/zh" ||
    cleanPath === "/" ||
    cleanPath === ""
  ) {
    return targetLang === "en" ? `${basePath}/` : `${basePath}/${targetLang}`;
  }
  // For unprefixed top-level routes like /tumors, /symptoms, /financial, /resources
  return `${basePath}/${targetLang}${cleanPath}`;
}

const langPrefix = `${basePath}/${currentLang}`;
const homeUrl =
  currentLang === "en" ? `${basePath}/` : `${basePath}/${currentLang}`;

const isJourney = cleanPath.includes("/journey");
const isTumors = cleanPath.includes("/tumors");
const isSymptoms = cleanPath.includes("/symptoms");
const isResources = cleanPath.includes("/resources");
const isFinancial = cleanPath.includes("/financial");

const navItems = [
  {
    name: t.nav.journey,
    href: `${langPrefix}/journey/1-diagnosis`,
    active: isJourney,
  },
  {
    name: t.nav.tumors,
    href: `${langPrefix}/tumors`,
    active: isTumors,
  },
  {
    name: t.nav.symptoms,
    href: `${langPrefix}/symptoms`,
    active: isSymptoms,
  },
  {
    name: t.nav.hospitals,
    href: `${langPrefix}/resources`,
    active: isResources,
  },
  {
    name: t.nav.financial,
    href: `${langPrefix}/financial`,
    active: isFinancial,
  },
];

function formatNavName(name: string, lang: Locale) {
  if (lang !== "zh") return name;
  if (name === "治疗旅程") return { parts: ["治疗", "旅程"] };
  if (name === "肿瘤指南") return { parts: ["肿瘤", "指南"] };
  if (name === "症状管理") return { parts: ["症状", "管理"] };
  if (name === "专科医院") return { parts: ["专科", "医院"] };
  if (name === "财务与福利") return { parts: ["财务与", "福利"] };
  return { parts: [name] };
}
---

<header
  class="bg-white border-b border-gray-200 sticky top-0 z-40"
  data-pagefind-ignore
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3">
    <div class="flex items-center justify-between gap-2 lg:gap-4">
      <a
        href={homeUrl}
        class="text-lg sm:text-xl font-bold text-gray-900 hover:text-primary transition-colors flex items-center gap-2 no-underline shrink-0"
      >
        <span class="text-primary text-2xl" aria-hidden="true">🍁</span>
        <span class="hidden sm:inline">
          {
            currentLang === "zh" ? (
              <span>
                <span class="inline-block">加拿大儿童肿瘤</span>
                <span class="inline-block">教育与支持平台</span>
              </span>
            ) : (
              t.brandName
            )
          }
        </span>
        <span class="sm:hidden font-extrabold text-primary">PedOnc</span>
      </a>

      <!-- Desktop Navigation -->
      <nav
        class="hidden md:flex items-center gap-1 lg:gap-2 text-sm font-medium"
        aria-label="Main Navigation"
      >
        {
          navItems.map((item) => {
            const formatted = formatNavName(item.name, currentLang);
            return (
              <a
                href={item.href}
                class={`px-2.5 py-1.5 min-h-[44px] inline-flex items-center text-center justify-center rounded-md transition-colors no-underline ${
                  item.active
                    ? "text-primary font-bold bg-sky-50 border-b-2 border-primary"
                    : "text-gray-700 hover:text-gray-900 hover:bg-gray-50"
                }`}
                aria-current={item.active ? "page" : undefined}
              >
                {typeof formatted === "string" ? (
                  formatted
                ) : (
                  <span>
                    {formatted.parts.map((part) => (
                      <span class="inline-block">{part}</span>
                    ))}
                  </span>
                )}
              </a>
            );
          })
        }
      </nav>

      <!-- Right Header Controls (Search + Language + Mobile Menu) -->
      <div class="flex items-center gap-2">
        <!-- Single Responsive Search Bar Instance -->
        <SearchBar lang={currentLang} />

        <!-- Desktop Language Switcher -->
        <div
          class="hidden md:flex ml-2 pl-2 border-l border-gray-200 items-center gap-1"
          aria-label="Language Selector"
        >
          <a
            href={getLangUrl("en")}
            hreflang="en"
            class={`px-2.5 py-1.5 min-h-[40px] inline-flex items-center rounded text-xs font-bold transition-colors no-underline ${
              currentLang === "en"
                ? "bg-primary text-white"
                : "text-gray-700 hover:text-primary hover:bg-gray-100"
            }`}
            aria-current={currentLang === "en" ? "page" : undefined}
            aria-label="English">EN</a
          >
          <a
            href={getLangUrl("fr")}
            hreflang="fr"
            class={`px-2.5 py-1.5 min-h-[40px] inline-flex items-center rounded text-xs font-bold transition-colors no-underline ${
              currentLang === "fr"
                ? "bg-primary text-white"
                : "text-gray-700 hover:text-primary hover:bg-gray-100"
            }`}
            aria-current={currentLang === "fr" ? "page" : undefined}
            aria-label="Français">FR</a
          >
          <a
            href={getLangUrl("zh")}
            hreflang="zh"
            class={`px-2.5 py-1.5 min-h-[40px] inline-flex items-center rounded text-xs font-bold transition-colors no-underline ${
              currentLang === "zh"
                ? "bg-primary text-white"
                : "text-gray-700 hover:text-primary hover:bg-gray-100"
            }`}
            aria-current={currentLang === "zh" ? "page" : undefined}
            aria-label="中文 (Chinese)">中文</a
          >
        </div>

        <!-- Mobile Language Toggle and Hamburger Button -->
        <div class="flex items-center gap-1 md:hidden">
          <a
            href={getLangUrl("en")}
            hreflang="en"
            class={`flex items-center justify-center min-h-[36px] min-w-[36px] px-2.5 py-1.5 text-xs font-bold rounded ${currentLang === "en" ? "bg-primary text-white" : "text-gray-700 bg-gray-100"}`}
            aria-label="EN">EN</a
          >
          <a
            href={getLangUrl("fr")}
            hreflang="fr"
            class={`flex items-center justify-center min-h-[36px] min-w-[36px] px-2.5 py-1.5 text-xs font-bold rounded ${currentLang === "fr" ? "bg-primary text-white" : "text-gray-700 bg-gray-100"}`}
            aria-label="FR">FR</a
          >
          <a
            href={getLangUrl("zh")}
            hreflang="zh"
            class={`flex items-center justify-center min-h-[36px] min-w-[36px] px-2.5 py-1.5 text-xs font-bold rounded ${currentLang === "zh" ? "bg-primary text-white" : "text-gray-700 bg-gray-100"}`}
            aria-label="中文">中</a
          >

          <button
            id="mobile-menu-button"
            type="button"
            class="p-2 min-h-[44px] min-w-[44px] rounded-md text-gray-700 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-primary"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Toggle Navigation Menu"
          >
            <svg
              id="menu-open-icon"
              class="h-6 w-6 block"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
              id="menu-close-icon"
              class="h-6 w-6 hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden pt-4 pb-3 border-t border-gray-200 mt-3 space-y-1"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class={`block px-3 py-2.5 rounded-md text-base font-medium transition-colors no-underline ${
              item.active
                ? "bg-sky-50 text-primary font-bold"
                : "text-gray-700 hover:bg-gray-50 hover:text-gray-900"
            }`}
            aria-current={item.active ? "page" : undefined}
          >
            {item.name}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script is:inline>
  function setupMobileMenu() {
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    const openIcon = document.getElementById("menu-open-icon");
    const closeIcon = document.getElementById("menu-close-icon");

    if (!button || !menu) return;

    button.onclick = () => {
      const isExpanded = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", String(!isExpanded));
      menu.classList.toggle("hidden");
      if (openIcon && closeIcon) {
        openIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
      }
    };
  }

  document.addEventListener("astro:page-load", setupMobileMenu);
  if (document.readyState !== "loading") {
    setupMobileMenu();
  } else {
    document.addEventListener("DOMContentLoaded", setupMobileMenu);
  }
</script>
